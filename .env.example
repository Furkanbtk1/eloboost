# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Application runtime connects through PgBouncer (pooled, transaction mode).
DATABASE_URL="postgresql://eloboost:eloboost@localhost:6433/eloboost"
# Migrations / Prisma Studio connect to Postgres directly (no pooler).
DIRECT_URL="postgresql://eloboost:eloboost@localhost:5433/eloboost"
# Max connections held by each app instance's pg pool.
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# 32 random bytes, base64. Encrypts game credentials, 2FA secrets and payout
# details (AES-256-GCM). Losing this key makes that data unreadable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
# Auth.js secret that signs/encrypts session tokens. Generate the same way as above.
AUTH_SECRET=""
# Trust the Host header (needed for `next start` and self-hosting; Vercel sets it).
AUTH_TRUST_HOST=true
# Staff and booster accounts must enable 2FA before using their panels.
REQUIRE_STAFF_2FA=true

# OAuth providers: each one appears on the login page only when both values are set.
# Callback URL to register at the provider: <app url>/api/auth/callback/<discord|google|twitch>
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_TWITCH_ID=""
AUTH_TWITCH_SECRET=""

# ---------------------------------------------------------------------------
# Payments: a provider is offered only when all of its values are set.
# Webhook URLs to register: <app url>/api/webhooks/stripe and /api/webhooks/coinbase
# ---------------------------------------------------------------------------
# Stripe (cards, Apple Pay, Google Pay). Test keys: dashboard.stripe.com/test/apikeys
# Locally: `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints the whsec_ secret.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Coinbase Commerce (crypto). Settings > API keys / Webhook subscriptions (shared secret).
COINBASE_COMMERCE_API_KEY=""
COINBASE_COMMERCE_WEBHOOK_SECRET=""
# Simulated "test payment" method for development. Always off when NODE_ENV=production.
PAYMENTS_SANDBOX=true

# ---------------------------------------------------------------------------
# Upstash Redis (rate limiting). Optional locally (in-memory fallback);
# required in production so limits are shared across instances.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Realtime chat and notifications. Locally: Soketi from docker-compose (values
# below). Production: create a Pusher Channels app and use its app id, key,
# secret and cluster, with PUSHER_HOST and PUSHER_PORT left empty.
# ---------------------------------------------------------------------------
PUSHER_APP_ID="eloboost"
PUSHER_KEY="eloboost-key"
PUSHER_SECRET="eloboost-secret"
PUSHER_CLUSTER="mt1"
PUSHER_HOST="localhost"
PUSHER_PORT="6001"
PUSHER_USE_TLS=false

# ---------------------------------------------------------------------------
# Chat screenshots: private S3-compatible bucket. Locally: RustFS from
# docker-compose (console at http://localhost:9001). Production: Cloudflare R2
# (S3_ENDPOINT="https://<account id>.r2.cloudflarestorage.com", S3_REGION="auto")
# or AWS S3 (S3_ENDPOINT empty). Leave S3_BUCKET empty to turn uploads off.
# ---------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="eloboost-uploads"
S3_ACCESS_KEY_ID="eloboost"
S3_SECRET_ACCESS_KEY="eloboost-secret"
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Live support (optional): Crisp website id. The widget loads only when set.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CRISP_WEBSITE_ID=""
