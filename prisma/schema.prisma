// =============================================================================
// Elo Boost Platform: database schema
//
// Conventions
// - Every primary key is a UUID (v7, time-ordered for index locality).
// - Money is Decimal(12,2). Order money fields are in the order's `currency`;
//   wallet balances and booster earnings are kept in USD.
// - Fields documented as "ciphertext" hold AES-256-GCM output produced by
//   src/lib/crypto.ts and are unreadable without ENCRYPTION_KEY.
// - Users and orders are never hard-deleted (financial history), so relations
//   to them use Restrict unless noted otherwise.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

/// ADMIN covers everything staff do: support, disputes, payouts, pricing and content.
enum UserRole {
  CUSTOMER
  BOOSTER
  ADMIN
}

enum BoosterStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

enum GameStatus {
  ACTIVE
  INACTIVE
}

/// DIVISION: tiered ladder (LoL, Valorant, TFT, Overwatch).
/// RATING: numeric rating (CS2 Premier / Elo).
enum RankSystem {
  DIVISION
  RATING
}

enum OrderType {
  DIVISION
  WIN
  PLACEMENT
  COACHING
}

/// AWAITING_PAYMENT -> PENDING (paid, in the booster pool) -> ASSIGNED (claimed)
/// -> IN_PROGRESS -> COMPLETED. PAUSED / DISPUTED / CANCELLED are side states.
enum OrderStatus {
  AWAITING_PAYMENT
  PENDING
  ASSIGNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum Currency {
  USD
  EUR
  GBP
  TRY
}

/// PAYMENT: customer pays an order. EARNING: booster cut credited to wallet.
/// TIP: customer tip to booster. PAYOUT: booster withdrawal. REFUND: money back
/// to customer. DEPOSIT: wallet top-up.
enum TransactionType {
  DEPOSIT
  PAYMENT
  EARNING
  TIP
  PAYOUT
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

/// WALLET: paid from the user's balance. MANUAL: admin adjustment.
/// SANDBOX: simulated payments, available only outside production.
enum PaymentGateway {
  STRIPE
  PAYPAL
  COINBASE
  NOWPAYMENTS
  XSOLLA
  G2A
  PAYTR
  IYZICO
  SKRILL
  ALIPAY
  WALLET
  MANUAL
  SANDBOX
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

/// LP_GAIN: LP/RR gained per win (normal, low, smurf queue).
/// ADD_ON: optional paid extras (priority, stream, VPN...).
enum ModifierCategory {
  LP_GAIN
  ADD_ON
}

enum PayoutMethod {
  CRYPTO
  BANK_TRANSFER
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum DisputeResolution {
  REFUNDED
  PARTIAL_REFUND
  REASSIGNED
  CONTINUED
}

enum NotificationType {
  ORDER_UPDATE
  NEW_MESSAGE
  PAYOUT_UPDATE
  DISPUTE_UPDATE
  SYSTEM
}

// -----------------------------------------------------------------------------
// Identity & auth
// -----------------------------------------------------------------------------

model User {
  id               String    @id @default(uuid(7)) @db.Uuid
  email            String    @unique
  emailVerified    DateTime?
  /// bcrypt hash. Null for OAuth-only accounts.
  passwordHash     String?
  name             String?
  role             UserRole  @default(CUSTOMER)
  avatarUrl        String?
  /// Wallet balance in USD. A CHECK constraint keeps it non-negative.
  balance          Decimal   @default(0) @db.Decimal(12, 2)
  is2FAEnabled     Boolean   @default(false)
  /// TOTP secret, ciphertext.
  twoFactorSecret  String?
  stripeCustomerId String?   @unique
  isBanned         Boolean   @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts             Account[]
  boosterProfile       BoosterProfile?
  customerOrders       Order[]               @relation("CustomerOrders")
  boosterOrders        Order[]               @relation("BoosterOrders")
  transactions         Transaction[]
  messages             Message[]
  reviewsGiven         Review[]              @relation("ReviewCustomer")
  reviewsReceived      Review[]              @relation("ReviewBooster")
  payoutRequests       PayoutRequest[]       @relation("PayoutRequester")
  reviewedPayouts      PayoutRequest[]       @relation("PayoutReviewer")
  disputesOpened       Dispute[]             @relation("DisputeOpener")
  disputesResolved     Dispute[]             @relation("DisputeResolver")
  credentialAccessLogs CredentialAccessLog[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  backupCodes          TwoFactorBackupCode[]

  @@index([role])
}

/// OAuth account links (Discord, Google, Twitch). Shape is Auth.js-compatible.
model Account {
  id                String   @id @default(uuid(7)) @db.Uuid
  userId            String   @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Email verification and password reset tokens. `token` stores a SHA-256 hash.
/// One-time 2FA recovery code (SHA-256 of the normalized code); `usedAt` marks it spent.
model TwoFactorBackupCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
}

/// Single-use email links. `identifier` is "reset:<userId>" or "verify:<userId>"; `token` is the SHA-256 of the emailed value.
model VerificationToken {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BoosterProfile {
  id              String        @id @default(uuid(7)) @db.Uuid
  userId          String        @unique @db.Uuid
  acceptedGames   Game[]
  /// Per game slug, e.g. { "league-of-legends": { "position": 26, "label": "Master" } }.
  /// Used to filter the order pool by the booster's own rank.
  currentRanks    Json          @default("{}")
  /// { method, iban | walletAddress, network }, ciphertext.
  payoutDetails   String?
  status          BoosterStatus @default(PENDING_APPROVAL)
  /// Lifetime earnings in USD.
  totalEarnings   Decimal       @default(0) @db.Decimal(12, 2)
  rating          Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount     Int           @default(0)
  completedOrders Int           @default(0)
  bio             String?
  languages       String[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// -----------------------------------------------------------------------------
// Catalog & pricing (admin-editable, no code changes needed)
// -----------------------------------------------------------------------------

model Game {
  id                  String      @id @default(uuid(7)) @db.Uuid
  name                String
  slug                String      @unique
  logoUrl             String?
  status              GameStatus  @default(ACTIVE)
  rankSystem          RankSystem
  supportedOrderTypes OrderType[]
  /// Flat fee in USD added to every order of this game.
  basePrice           Decimal     @default(0) @db.Decimal(10, 2)
  /// USD per hour for COACHING orders.
  coachingHourlyRate  Decimal?    @db.Decimal(10, 2)
  sortOrder           Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  rankSteps      RankStep[]
  ratingBrackets RatingBracket[]
  servers        GameServer[]
  modifiers      PriceModifier[]
  orders         Order[]
  boosters       BoosterProfile[]

  @@index([status, sortOrder])
}

/// One rung of a DIVISION ladder, e.g. LoL "Gold II". `position` orders the
/// ladder from 0 (lowest). Prices are in USD.
model RankStep {
  id             String   @id @default(uuid(7)) @db.Uuid
  gameId         String   @db.Uuid
  position       Int
  tier           String
  /// Null for single-rung tiers such as Master or Radiant.
  division       String?
  iconUrl        String?
  /// Cost of climbing from this rung to the next one. Null on the top rung.
  divisionPrice  Decimal? @db.Decimal(10, 2)
  /// Price of one win while at this rank (WIN orders).
  winPrice       Decimal  @db.Decimal(10, 2)
  /// Price of one placement game when last season ended here (PLACEMENT orders).
  placementPrice Decimal  @db.Decimal(10, 2)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, position])
}

/// Price band for RATING games, e.g. CS2 Premier. Covers [minRating, maxRating).
model RatingBracket {
  id          String  @id @default(uuid(7)) @db.Uuid
  gameId      String  @db.Uuid
  minRating   Int
  maxRating   Int
  /// USD per 100 rating points gained inside this band.
  pricePer100 Decimal @db.Decimal(10, 2)
  /// USD per win while inside this band (WIN orders).
  winPrice    Decimal @db.Decimal(10, 2)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, minRating])
}

model GameServer {
  id            String  @id @default(uuid(7)) @db.Uuid
  gameId        String  @db.Uuid
  /// Short code shown to users, e.g. "EUW".
  code          String
  name          String
  /// Region group used for booster matching, e.g. "EU", "NA".
  region        String
  /// Percentage surcharge for this server, e.g. 10 = +10%.
  priceModifier Decimal @default(0) @db.Decimal(5, 2)
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, code])
}

/// Percentage modifier applied on top of the base price.
model PriceModifier {
  id          String           @id @default(uuid(7)) @db.Uuid
  gameId      String           @db.Uuid
  category    ModifierCategory
  /// Stable identifier used by the calculator, e.g. "priority", "low_lp".
  key         String
  label       String
  description String?
  /// e.g. 20 = +20%, -10 = -10%.
  percentage  Decimal          @db.Decimal(5, 2)
  /// Order types this modifier applies to. Empty = all.
  orderTypes  OrderType[]
  /// Pre-selected option of its category (one LP_GAIN option per game).
  isDefault   Boolean          @default(false)
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, key])
  @@index([gameId, category])
}

model PromoCode {
  id             String       @id @default(uuid(7)) @db.Uuid
  /// Stored upper-case.
  code           String       @unique
  discountType   DiscountType
  /// Percent for PERCENTAGE, USD for FIXED.
  discountValue  Decimal      @db.Decimal(10, 2)
  /// Null = unlimited.
  maxUses        Int?
  currentUses    Int          @default(0)
  expiresAt      DateTime?
  /// Minimum order subtotal in USD.
  minOrderAmount Decimal?     @db.Decimal(10, 2)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orders Order[]
}

// -----------------------------------------------------------------------------
// Orders
// -----------------------------------------------------------------------------

model Order {
  id                String      @id @default(uuid(7)) @db.Uuid
  /// Human-friendly reference, e.g. "ELO-12491".
  orderNumber       String      @unique
  customerId        String      @db.Uuid
  boosterId         String?     @db.Uuid
  gameId            String      @db.Uuid
  orderType         OrderType
  /// Snapshot at checkout, e.g. { "position": 12, "label": "Gold IV" } or { "rating": 9500 }.
  startRank         Json
  desiredRank       Json
  /// Live progress reported by the booster.
  currentRank       Json?
  /// Wins (WIN), games (PLACEMENT) or hours (COACHING).
  quantity          Int?
  /// GameServer.code snapshot.
  server            String
  region            String
  /// Price before discount, in `currency`.
  subtotal          Decimal     @db.Decimal(12, 2)
  discountAmount    Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal     @db.Decimal(12, 2)
  boosterCutAmount  Decimal     @db.Decimal(12, 2)
  platformCutAmount Decimal     @db.Decimal(12, 2)
  currency          Currency    @default(USD)
  /// Value of 1 unit of `currency` in USD at checkout time.
  exchangeRate      Decimal     @default(1) @db.Decimal(18, 8)
  status            OrderStatus @default(AWAITING_PAYMENT)
  /// Game account login, ciphertext. Entered by the customer after payment.
  accountUsername   String?
  /// Game account password, ciphertext.
  accountPassword   String?
  /// Selected options and the server-computed price breakdown, e.g.
  /// { "lpGain": "low_lp", "addOns": ["priority"], "breakdown": {...} }.
  extraOptions      Json        @default("{}")
  vpnRequired       Boolean     @default(false)
  promoCodeId       String?     @db.Uuid
  /// Customer note for the booster (preferred champions, schedule...).
  notes             String?
  paidAt            DateTime?
  assignedAt        DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  customer             User                  @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  booster              User?                 @relation("BoosterOrders", fields: [boosterId], references: [id], onDelete: SetNull)
  game                 Game                  @relation(fields: [gameId], references: [id], onDelete: Restrict)
  promoCode            PromoCode?            @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  transactions         Transaction[]
  messages             Message[]
  review               Review?
  disputes             Dispute[]
  credentialAccessLogs CredentialAccessLog[]

  @@index([status, gameId])
  @@index([customerId, createdAt])
  @@index([boosterId, status])
}

/// Append-only money ledger. `amount` is always positive; the direction is
/// implied by `type`.
model Transaction {
  id                   String            @id @default(uuid(7)) @db.Uuid
  orderId              String?           @db.Uuid
  userId               String            @db.Uuid
  payoutRequestId      String?           @unique @db.Uuid
  type                 TransactionType
  amount               Decimal           @db.Decimal(12, 2)
  currency             Currency
  gateway              PaymentGateway
  /// Provider reference (Stripe session id, PayPal capture id...).
  gatewayTransactionId String?
  status               TransactionStatus @default(PENDING)
  metadata             Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  order         Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  payoutRequest PayoutRequest? @relation(fields: [payoutRequestId], references: [id], onDelete: Restrict)

  /// Makes webhook processing idempotent.
  @@unique([gateway, gatewayTransactionId])
  @@index([userId, createdAt])
  @@index([orderId])
  @@index([type, status])
}

model Message {
  id            String   @id @default(uuid(7)) @db.Uuid
  orderId       String   @db.Uuid
  senderId      String   @db.Uuid
  content       String   @db.Text
  /// Object key in the private bucket: orders/<order id>/<file id>.<ext>
  attachmentKey String?
  isRead        Boolean  @default(false)
  /// Set when the toxicity filter matched.
  isFlagged     Boolean  @default(false)
  createdAt     DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model Review {
  id         String   @id @default(uuid(7)) @db.Uuid
  orderId    String   @unique @db.Uuid
  customerId String   @db.Uuid
  boosterId  String   @db.Uuid
  /// 1-5, enforced by a CHECK constraint.
  rating     Int
  comment    String?  @db.Text
  isPublic   Boolean  @default(true)
  createdAt  DateTime @default(now())

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer User  @relation("ReviewCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  booster  User  @relation("ReviewBooster", fields: [boosterId], references: [id], onDelete: Restrict)

  @@index([boosterId, isPublic])
}

/// Logged every time a booster reveals the customer's game credentials.
model CredentialAccessLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  orderId     String   @db.Uuid
  boosterId   String   @db.Uuid
  /// VPN exit location the booster must report before the reveal.
  vpnLocation String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  booster User  @relation(fields: [boosterId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model Dispute {
  id             String             @id @default(uuid(7)) @db.Uuid
  orderId        String             @db.Uuid
  openedById     String             @db.Uuid
  reason         String             @db.Text
  status         DisputeStatus      @default(OPEN)
  resolution     DisputeResolution?
  adminNote      String?            @db.Text
  /// Order status to restore when resolved as CONTINUED.
  previousStatus OrderStatus
  resolvedById   String?            @db.Uuid
  createdAt      DateTime           @default(now())
  resolvedAt     DateTime?

  order      Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  openedBy   User  @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Restrict)
  resolvedBy User? @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([orderId])
}

// -----------------------------------------------------------------------------
// Booster payouts
// -----------------------------------------------------------------------------

model PayoutRequest {
  id           String       @id @default(uuid(7)) @db.Uuid
  boosterId    String       @db.Uuid
  /// USD.
  amount       Decimal      @db.Decimal(12, 2)
  method       PayoutMethod
  /// Snapshot of the payout destination at request time, ciphertext.
  destination  String
  status       PayoutStatus @default(PENDING)
  reviewedById String?      @db.Uuid
  reviewedAt   DateTime?
  adminNote    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  booster     User         @relation("PayoutRequester", fields: [boosterId], references: [id], onDelete: Restrict)
  reviewedBy  User?        @relation("PayoutReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  transaction Transaction?

  @@index([status, createdAt])
  @@index([boosterId])
}

// -----------------------------------------------------------------------------
// Notifications, settings, audit
// -----------------------------------------------------------------------------

/// In-app notification (bell icon). Text is rendered client-side from `type`
/// and `data` so it follows the viewer's language.
model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  data      Json             @default("{}")
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

/// Platform-wide configuration editable from the admin panel, e.g.
/// "booster_commission_rate", "min_payout_amount".
model Setting {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

/// Every admin-side action (price change, refund, payout approval...).
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  adminId    String   @db.Uuid
  /// Dotted verb, e.g. "order.refund", "pricing.update".
  action     String
  targetType String?
  targetId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}
